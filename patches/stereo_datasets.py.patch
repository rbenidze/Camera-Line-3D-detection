+class DrivingStereo(StereoDataset):
+    def __init__(self, aug_params=None, root='datasets/DrivingStereo'):
+        super(DrivingStereo, self).__init__(aug_params, sparse=True, reader=frame_utils.readDispKITTI)
+        assert os.path.exists(root), f"DrivingStereo root not found: {root}"
+
+        sequences = sorted([d for d in os.listdir(os.path.join(root, 'left')) 
+                            if os.path.isdir(os.path.join(root, 'left', d))])
+        
+        for seq in sequences:
+            left_dir = os.path.join(root, 'left', seq)
+            right_dir = os.path.join(root, 'right', seq)
+            disp_dir = os.path.join(root, 'disparity', seq)
+            
+            if not (os.path.exists(right_dir) and os.path.exists(disp_dir)):
+                logging.warning(f"Skipping {seq}: missing right or disparity folder")
+                continue
+            
+            left_images = sorted(glob(os.path.join(left_dir, '*.jpg')))
+            
+            for left_img in left_images:
+                fname = os.path.basename(left_img).replace('.jpg', '.png')
+                right_img = os.path.join(right_dir, os.path.basename(left_img))
+                disp_img = os.path.join(disp_dir, fname)
+                
+                if os.path.exists(right_img) and os.path.exists(disp_img):
+                    self.image_list += [[left_img, right_img]]
+                    self.disparity_list += [disp_img]
+        
+        logging.info(f"DrivingStereo: loaded {len(self.image_list)} stereo pairs")           
+
 
